# LifeBridge Frontend Production Environment Configuration
# Point NEXT_PUBLIC_API_URL to your deployed FastAPI backend URL (e.g. on Render or Railway)
NEXT_PUBLIC_API_URL=https://lifebridge-api.onrender.com

# Point NEXT_PUBLIC_WS_URL to your deployed WebSocket endpoint
NEXT_PUBLIC_WS_URL=wss://lifebridge-api.onrender.com/ws/agent-ticker

# Fast2SMS Gateway API Key
FAST2SMS_API_KEY=
